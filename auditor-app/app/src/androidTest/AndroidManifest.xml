<?xml version="1.0" encoding="utf-8"?>
<!--
  Test-only fixture Activities. These deliberately don't belong in the app's
  own manifest (src/main) — they exist purely so AtfScanParityTest can launch
  a known-bad XML tree and a known-bad Compose tree and run the same ATF scan
  against both.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity android:name=".XmlFixtureActivity" android:exported="false" />
        <activity android:name=".ComposeFixtureActivity" android:exported="false" />
    </application>
</manifest>
